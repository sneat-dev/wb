---
import DashboardView from '../../../components/DashboardView.astro';
import { dashboardShell } from '../../../data/dashboard';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { host: 'github.com', org: 'org' } }];
}

const { host, org } = Astro.params;
const dashboard = dashboardShell({ kind: 'org', host: host!, org: org! });
---

<BaseLayout title={`${dashboard.title} — Workbench dashboard`} description="Organisation-level Workbench timing, contribution, dependency and verified delivery metrics." path={`/org/${host}/${org}/`}>
  <DashboardView {dashboard} />
</BaseLayout>
