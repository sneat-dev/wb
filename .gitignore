dist/
# hub/web/dist is the Astro build output and stays ignored, with one exception:
# //go:embed refuses a directory that does not exist, so a clean clone must
# still carry hub/web/dist/.gitkeep or hub/web/embed.go will not compile. Git
# cannot re-include a file whose parent directory is excluded, so the directory
# is re-included first and everything but the placeholder excluded again. The
# Astro build copies hub/web/public/.gitkeep back into dist/, so building never
# deletes the tracked file.
!hub/web/dist/
hub/web/dist/*
!hub/web/dist/.gitkeep
node_modules/
.astro/
test-results/
*.o
*.exe
*.test
*.out
.DS_Store
# SpecScore runtime state. The lifecycle skills append to
# `.specscore/events.jsonl` and keep delivery bookkeeping in
# `.specscore/event-outbox/`; both are local to one checkout — they record
# absolute paths and uncommitted revisions — so they are never committed.
# (`.specscore-lifecycle.lock` is the older sibling of this rule.)
.specscore/
.specscore-lifecycle.lock

# Generated per-checkout marker; see AGENTS.md. Never commit it.
/.worktree.md

# The CLI binary `go build ./cmd/...` drops in the repository root. It is 30 MB
# and `git add -A` will stage it, so ignoring it is the only thing that keeps a
# routine build out of a commit.
/wb

# Local coverage measurement output: `wb coverage --report-dir` and --coverage-profile.
/coverage-diagnostics/
/profile.cov

# Python bytecode caches (tools/sdlc-metrics and any other Python tooling).
__pycache__/
*.pyc
