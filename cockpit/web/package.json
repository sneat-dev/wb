{
  "name": "wb-cockpit-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WB Cockpit: the Angular application embedded in the wb binary and served under /cockpit/.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nx build cockpit && node tools/finish-build.mjs",
    "lint": "nx run-many -t lint -p cockpit cockpit-e2e fleet-data ui",
    "test": "node tools/check-component-specs.mjs && vitest run --coverage",
    "test:e2e": "playwright test -c apps/cockpit-e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/architect": "0.2201.9",
    "@angular-devkit/schematics": "22.1.9",
    "@angular/build": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~4.1.10",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^1.8.3",
    "jsdom": "^27.4.0",
    "nx": "23.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@angular/cdk": "22.1.8",
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "@primeuix/themes": "^3.0.1",
    "primeng": "^22.1.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.3"
  }
}
