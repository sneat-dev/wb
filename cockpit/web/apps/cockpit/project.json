{
  "name": "cockpit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cockpit/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist"],
      "options": {
        "outputPath": {
          "base": "dist",
          "browser": ""
        },
        "browser": "apps/cockpit/src/main.ts",
        "index": "apps/cockpit/src/index.html",
        "baseHref": "/cockpit/",
        "tsConfig": "apps/cockpit/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/cockpit/public"
          }
        ],
        "styles": [
          "apps/cockpit/src/styles/tokens.css",
          "apps/cockpit/src/styles/base.css",
          "apps/cockpit/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "statsJson": true,
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "preview": {
          "outputPath": {
            "base": "dist-preview",
            "browser": ""
          },
          "fileReplacements": [
            {
              "replace": "apps/cockpit/src/app/gallery/gallery-routes.ts",
              "with": "apps/cockpit/src/app/gallery/gallery-routes.preview.ts"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          }
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
