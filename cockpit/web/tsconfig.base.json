{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@cockpit/fleet-data": ["./libs/fleet-data/src/index.ts"],
      "@cockpit/fleet-data/home-details": ["./libs/fleet-data/src/home-details.ts"],
      "@cockpit/fleet-data/panel": ["./libs/fleet-data/src/panel.ts"],
      "@cockpit/fleet-data/task-reason": ["./libs/fleet-data/src/task-reason.ts"],
      "@cockpit/fleet-data/commands": ["./libs/fleet-data/src/commands.ts"],
      "@cockpit/fleet-data/list": ["./libs/fleet-data/src/list.ts"],
      "@cockpit/fleet-data/lazy-client": ["./libs/fleet-data/src/lazy-client.ts"],
      "@cockpit/fleet-data/testing": ["./libs/fleet-data/src/testing.ts"],
      "@cockpit/ui/viewport-mount": ["./libs/ui/src/lib/viewport-mount/viewport-mount.ts"],
      "@cockpit/ui/code-index-label": ["./libs/ui/src/lib/code-index-label/code-index-label.ts"],
      "@cockpit/ui/code-index-panel": ["./libs/ui/src/lib/code-index-panel/code-index-panel.ts"],
      "@cockpit/ui/list": ["./libs/ui/src/lib/list/index.ts"],
      "@cockpit/ui/list-host": ["./libs/ui/src/lib/list/list-host.ts"],
      "@cockpit/ui/panel": ["./libs/ui/src/lib/panel/index.ts"],
      "@cockpit/ui": ["./libs/ui/src/index.ts"],
      "@cockpit/ui/control": ["./libs/ui/src/control.ts"],
      "@cockpit/ui/state": ["./libs/ui/src/state.ts"],
      "@cockpit/ui/status": ["./libs/ui/src/status.ts"],
      "@cockpit/ui/chart": ["./libs/ui/src/chart.ts"]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
