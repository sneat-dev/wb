{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@cockpit/fleet-data": ["./libs/fleet-data/src/index.ts"],
      "@cockpit/fleet-data/home-details": ["./libs/fleet-data/src/home-details.ts"],
      "@cockpit/fleet-data/panel": ["./libs/fleet-data/src/panel.ts"],
      "@cockpit/fleet-data/commands": ["./libs/fleet-data/src/commands.ts"],
      "@cockpit/fleet-data/list": ["./libs/fleet-data/src/list.ts"],
      "@cockpit/fleet-data/testing": ["./libs/fleet-data/src/testing.ts"],
      "@cockpit/ui/count": ["./libs/ui/src/lib/count/count.ts"],
      "@cockpit/ui/route-label": ["./libs/ui/src/lib/route-label/route-label.ts"],
      "@cockpit/ui": ["./libs/ui/src/index.ts"],
      "@cockpit/ui/control": ["./libs/ui/src/control.ts"],
      "@cockpit/ui/state": ["./libs/ui/src/state.ts"],
      "@cockpit/ui/chart": ["./libs/ui/src/chart.ts"]
    },
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
